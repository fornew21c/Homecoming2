# 귀가마중 — HTTPS 종단.
#
# Caddy 를 쓰는 이유는 인증서를 스스로 받고 갱신하기 때문이다. 이 서버는 혼자
# 돌아야 하고, 90일마다 사람이 갱신해야 하는 구성은 언젠가 잊는다. 그날 앱은
# 통째로 멈추고 가족은 아무것도 못 본다.
#
# 설치
#   sudo apt install caddy
#   sudo cp Deploy/Caddyfile /etc/caddy/Caddyfile   # 도메인을 먼저 바꿔라
#   sudo systemctl reload caddy

homecoming.example.com {

	# 인증서 문제 알림을 받을 주소. 없으면 만료 경고가 아무 데도 안 간다.
	# 개인 프로젝트다 — 회사 주소를 쓰지 마라.
	tls you@example.com

	encode zstd gzip

	# --- 앱만 온다 -------------------------------------------------------
	#
	# 브라우저용 헤더(CSP, X-Frame-Options)는 넣지 않는다. 여기에 HTML 이
	# 없으므로 아무 일도 하지 않는 헤더이고, 안 하는 일을 하는 것처럼 보이는
	# 설정은 나중에 판단을 흐린다.
	header {
		# 한 번 HTTPS 로 온 클라이언트는 다음부터 평문으로 시도하지 않는다.
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}

	reverse_proxy 127.0.0.1:8787 {
		# 위치 보고는 늦으면 의미가 없다. 앱도 8초에 포기한다.
		transport http {
			dial_timeout 5s
			response_header_timeout 15s
		}
	}

	# 로그에서 세션 id 를 지운다.
	#
	# 본문에 좌표가 있으니 URL 만으로 좌표가 새지는 않는다. 하지만
	# `/session/{id}/location` 이 언제 몇 번 왔는지는 **그 사람이 언제 이동했는지**
	# 를 그대로 드러내고, 세션 id 가 붙어 있으면 하루치를 한 줄로 엮을 수 있다.
	# 서버는 위치를 최근 20건만 들고 있다. 로그가 전량을 들고 있으면 그게 무의미해진다.
	#
	# 지우지 않는 것 — 메서드, 상태코드, 소요시간. 고장을 찾는 데 필요하고
	# 개인을 가리키지 않는다.
	log {
		output file /var/log/caddy/homecoming.log {
			roll_size 10MiB
			roll_keep 3
		}
		format filter {
			wrap json
			fields {
				request>uri regexp "/session/[^/]+/" "/session/-/"
				# Caddy 가 기본으로 가리지만 명시한다. 이게 새면 계정 하나가 새는 것이다.
				request>headers>Authorization delete
				request>headers>Cookie delete
			}
		}
	}
}
